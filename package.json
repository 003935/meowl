{
  "name": "tweet-deleter",
  "version": "2.0.0",
  "description": "Browse your Twitter/X archive and bulk-delete old tweets, replies and retweets",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare:devkit": "electrobun prepare",
    "start": "electrobun prepare && vite build && electrobun dev",
    "dev": "electrobun prepare && vite build && electrobun dev --watch",
    "dev:hmr": "concurrently -k \"vite\" \"bun run start\"",
    "build": "electrobun prepare && vite build && electrobun build --env=stable",
    "build:canary": "electrobun prepare && vite build && electrobun build --env=canary",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.bun.json",
    "delete:dry": "bun delete-selected.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "emusks": "^2.3.19",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electrobun": "2.0.2",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "vite": "^8"
  }
}
